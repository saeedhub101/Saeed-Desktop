import { VerticalBox, HorizontalBox, LineEdit, Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Saeed";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 500px;

    in-out property <string> status: "Ready";
    in-out property <string> conversation: "Saeed is ready. Chat and voice share one conversation.";
    in-out property <string> voice_button_text: "Mic ON";
    in-out property <bool> settings_open: false;
    in-out property <string> settings_api_key: "";
    in-out property <string> settings_ai_model: "gpt-6-luna";
    in-out property <string> settings_stt_model: "gpt-4o-mini-transcribe";
    in-out property <string> settings_tts_model: "gpt-4o-mini-tts";
    in-out property <string> settings_tts_voice: "alloy";
    in-out property <string> settings_api_key_status: "Stored securely in Windows Credential Manager";
    in-out property <string> settings_status: "";

    callback send-message(string);
    callback toggle-voice();
    callback save-settings(string, string, string, string, string);
    callback clear-api-key();

    if !settings_open: VerticalBox {
        padding: 28px;
        spacing: 18px;

        HorizontalBox {
            Text {
                text: "Saeed";
                font-size: 34px;
                horizontal-stretch: 1;
            }

            Button {
                text: "Settings";
                clicked => { root.settings_open = true; }
            }
        }

        Text {
            text: "AI desktop companion";
            font-size: 16px;
            horizontal-alignment: center;
        }

        Rectangle {
            border-width: 1px;
            border-radius: 12px;
            vertical-stretch: 1;

            VerticalBox {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: conversation;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: status;
                    font-size: 13px;
                }

                HorizontalBox {
                    spacing: 10px;

                    LineEdit {
                        id: message-input;
                        placeholder-text: "Talk to Saeed...";
                    }

                    Button {
                        text: "Send";
                        clicked => {
                            root.send-message(message-input.text);
                            message-input.text = "";
                        }
                    }

                    Button {
                        text: "Send";
                        clicked => {
                            root.send-message(message-input.text);
                            message-input.text = "";
                        }
                    }

                    Button {
                        text: voice_button_text;
                        clicked => { root.toggle-voice(); }
                    }
                }
            }
        }
    }

    if settings_open: VerticalBox {
        padding: 28px;
        spacing: 14px;

        HorizontalBox {
            Text {
                text: "Settings";
                font-size: 30px;
                horizontal-stretch: 1;
            }

            Button {
                text: "Back";
                clicked => { root.settings_open = false; }
            }
        }

        Text { text: "OpenAI"; font-size: 18px; }

        Text { text: "API key (stored in Windows Credential Manager)"; }
        LineEdit {
            input-type: password;
            placeholder-text: "Enter API key to save or replace";
            edited => { root.settings_api_key = self.text; }
        }

        Text {
            text: settings_api_key_status;
            font-size: 12px;
        }

        Text { text: "AI model"; }
        LineEdit { text: settings_ai_model; edited => { root.settings_ai_model = self.text; } }

        Text { text: "Speech-to-text model"; }
        LineEdit { text: settings_stt_model; edited => { root.settings_stt_model = self.text; } }

        Text { text: "Text-to-speech model"; }
        LineEdit { text: settings_tts_model; edited => { root.settings_tts_model = self.text; } }

        Text { text: "TTS voice"; }
        LineEdit { text: settings_tts_voice; edited => { root.settings_tts_voice = self.text; } }

        HorizontalBox {
            spacing: 10px;

            Button {
                text: "Save";
                clicked => {
                    root.save-settings(
                        settings_api_key,
                        settings_ai_model,
                        settings_stt_model,
                        settings_tts_model,
                        settings_tts_voice
                    );
                }
            }

            Button {
                text: "Remove API key";
                clicked => { root.clear-api-key(); }
            }
        }

        Text {
            text: settings_status;
            wrap: word-wrap;
            font-size: 12px;
        }

        Rectangle { vertical-stretch: 1; }
    }
}