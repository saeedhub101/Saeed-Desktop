import { VerticalBox, HorizontalBox, LineEdit, Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Saeed";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 760px;
    min-height: 500px;

    in-out property <string> status: "Ready";
    in-out property <string> conversation: "Saeed is ready. Chat and voice share one conversation.";

    callback send-message(string);
    callback submit-voice-transcript(string);

    VerticalBox {
        padding: 28px;
        spacing: 18px;

        Text {
            text: "Saeed";
            font-size: 34px;
            horizontal-alignment: center;
        }

        Text {
            text: "AI desktop companion";
            font-size: 16px;
            horizontal-alignment: center;
        }

        Rectangle {
            border-width: 1px;
            border-radius: 12px;
            vertical-stretch: 1;

            VerticalBox {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: conversation;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: status;
                    font-size: 13px;
                }

                HorizontalBox {
                    spacing: 10px;

                    LineEdit {
                        placeholder-text: "Talk to Saeed...";
                        edited => { root.send-message(self.text); }
                    }

                    Button {
                        text: "Voice";
                        clicked => {
                            root.status = "Voice input will use this same conversation.";
                        }
                    }

                    Button {
                        text: "Settings";
                        clicked => {
                            root.status = "Set OPENAI_API_KEY, then restart Saeed.";
                        }
                    }
                }
            }
        }
    }
}
